# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в git не коммитится (см. .gitignore).

# Ключ API Yandex AI Studio (OpenAI-совместимый Responses/Completion API).
YANDEX_API_KEY=

# Идентификатор каталога (folder_id) в Yandex Cloud, где выпущен ключ.
YANDEX_FOLDER_ID=

# Опционально: полный URI модели для hypothesis_gen.
# По умолчанию используется gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest
YANDEX_MODEL_URI=

# Опционально: base_url переопределять не нужно, но оставлено для гибкости.
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# true (по умолчанию) — hypothesis_gen работает в мок-режиме без реального
# вызова Yandex API и без необходимости в ключах. Поставьте false, когда
# ключи будут готовы и вы захотите использовать реальную модель.
USE_MOCK_LLM=true
